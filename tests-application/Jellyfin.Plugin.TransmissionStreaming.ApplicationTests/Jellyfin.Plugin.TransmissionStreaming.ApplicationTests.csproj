<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <OutputType>Exe</OutputType>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../../tests/TransmissionStreaming.TestSupport/TransmissionStreaming.TestSupport.csproj" />
        <ProjectReference Include="../../src/Jellyfin.Plugin.TransmissionStreaming/Jellyfin.Plugin.TransmissionStreaming.csproj" ReferenceOutputAssembly="false" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
        <PackageReference Include="AutoFixture" />
        <PackageReference Include="AutoFixture.AutoMoq" />
        <PackageReference Include="FluentAssertions" />
    </ItemGroup>
    <ItemGroup>
        <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <Target Name="CopyPluginBundle" AfterTargets="Build">
        <ItemGroup>
            <PluginBundle Include="../../src/Jellyfin.Plugin.TransmissionStreaming/bin/$(Configuration)/$(TargetFramework)/Jellyfin.Plugin.TransmissionStreaming.dll" />
            <PluginBundle Include="../../src/Jellyfin.Plugin.TransmissionStreaming/bin/$(Configuration)/$(TargetFramework)/TransmissionStreaming.*.dll" />
            <PluginBundle Include="../../src/Jellyfin.Plugin.TransmissionStreaming/bin/$(Configuration)/$(TargetFramework)/Mediator.dll" />
            <PluginBundle Include="../../src/Jellyfin.Plugin.TransmissionStreaming/bin/$(Configuration)/$(TargetFramework)/meta.json" />
        </ItemGroup>
        <Copy SourceFiles="@(PluginBundle)" DestinationFolder="$(OutDir)Plugin" />
    </Target>
</Project>
